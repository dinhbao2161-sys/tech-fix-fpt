# GEMINI_API_KEY: Required for Gemini AI API calls (vision diagnosis + content moderation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Google OAuth2 Credentials (for "Đăng nhập bằng Google" popup flow)
# Configure Callback URL: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin Configuration (defaults to dinhbao2161@gmail.com)
ADMIN_EMAIL="dinhbao2161@gmail.com"
# Optional: Secret password if logging into Admin account via Email + Password form
ADMIN_PASSWORD=""

# Session signing secret (auto-generated fallback used locally if omitted)
SESSION_SECRET=""
